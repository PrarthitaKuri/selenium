from selenium import webdriver
from selenium.webdriver.common.by import By

driver = webdriver.Chrome()
driver.get("https://the-internet.herokuapp.com/checkboxes")

checkboxes = driver.find_elements(By.CSS_SELECTOR, "input[type='checkbox']")

for chx in checkboxes:
    label_text = driver.execute_script(
        "return arguments[0].nextSibling.textContent;", chx
    ).strip()
    is_checked = chx.is_selected()
    print(f"{label_text} -> Checked: {is_checked}")
    
driver.get("https://the-internet.herokuapp.com/status_codes")

links = driver.find_elements(By.CSS_SELECTOR, "#content ul li a")

for link in links:
    print(link.text)

driver.quit()
