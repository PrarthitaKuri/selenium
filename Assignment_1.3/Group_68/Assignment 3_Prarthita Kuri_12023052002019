from selenium import webdriver
driver = webdriver.Chrome()

driver.get(r"file:///C:/Users/Disha/Documents/Python Automation/index.html")

# ID starts with "user_"
users = driver.find_elements(
    "css selector",
    '[id^="user_"]'
)
print("IDs starting with user_:")
for user in users:
    print(user.get_attribute("id"))

# ID contains "login"
login = driver.find_elements(
    "css selector",
    '[id*="login"]'
)
print("\nIDs containing login:")
for x in login:
    print(x.get_attribute("id"))

# ID ends with "123"
button = driver.find_elements(
    "css selector",
    '[id$="123"]'
)
print("\nIDs ending with 123:")
for x in button:
    print(x.get_attribute("id"))


